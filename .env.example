# ── Cliente (Vite). Publicables y seguras para el navegador ──
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_TU_ANON_KEY

# ── Firebase Web Push (mismo proyecto que la app móvil) ──────
# Config del Web App de Firebase (Consola > Configuración del proyecto >
# Tus apps > App web) y la clave VAPID pública (Consola > Cloud Messaging >
# Certificados push web). Son claves publicables del cliente, no secretos.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# ── Servidor (Vercel Function /api/invite-doctor) ─────────────
# La service_role key tiene permisos totales: SOLO como variable de entorno
# del servidor (Vercel > Settings > Environment Variables), NUNCA con prefijo
# VITE_ para que no se compile al navegador. Para pruebas locales con
# `vercel dev` se pueden definir también en este .env (no versionado).
# SUPABASE_URL=https://TU-PROYECTO.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_TU_SERVICE_ROLE_KEY